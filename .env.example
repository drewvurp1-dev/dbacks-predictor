ODDS_API_KEY=your_odds_api_key_here

# ── Ranked-choice destination vote (see docs/VOTE-SETUP.md) ──
# DATABASE_URL is shared with sync/push.
DATABASE_URL=postgres://user:pass@host:5432/dbname
VOTE_ADMIN_KEY=a_long_random_string
VOTE_RESULT_EMAIL=you@example.com

# Email transport — set EITHER Resend or SMTP. Without one, results still
# appear on the admin page; only the email is skipped.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional
# VOTE_POLL_ID=trip     # namespace a second, separate poll
# DATABASE_SSL=0        # disable SSL for a local Postgres
